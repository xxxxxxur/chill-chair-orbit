    <GameManaged>$(GamePath)\Chill With You_Data\Managed</GameManaged>
    <GameBepInEx>$(GamePath)\BepInEx\core</GameBepInEx>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameBepInEx)\BepInEx.dll" Private="false" />
